{
  "name": "jingles-demo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "server": "pnpm --filter server dev",
    "mobile": "pnpm --filter @jingles/mobile start",
    "ios": "pnpm --filter @jingles/mobile ios",
    "android": "pnpm --filter @jingles/mobile android",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "seed": "pnpm --filter server seed",
    "reset-db": "rm -f apps/server/data.db apps/server/data.db-shm apps/server/data.db-wal"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["better-sqlite3", "esbuild"]
  }
}
